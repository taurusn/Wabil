# Claude
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6
PORT=8787

# Web Push (VAPID) — generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=mailto:you@example.com

# PWA static files, relative to the server dir
PWA_DIR=../app/dist

# Watcher — the proactive poke loop. Polls Gmail, classifies each new email
# (now / morning / ignore) and pokes. Set WATCH_ENABLED=false to turn it off.
WATCH_ENABLED=true
WATCH_INTERVAL_MS=300000
WATCH_QUERY=in:inbox is:unread newer_than:2d
WATCH_MAX=10
WATCH_TZ=Asia/Riyadh
WATCH_MORNING_HOUR=7
